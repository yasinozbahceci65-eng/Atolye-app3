{
  "expo": {
    "name": "Atölye; Mimar, Usta",
    "slug": "atolye-toolbox",
    "owner": "theyasinoz",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/ATOLYEM_20260829_082715_0000.png",
    "scheme": "atolyeapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Kamera, barkod ve QR kod taramak için kullanılır.",
        "NSPhotoLibraryUsageDescription": "Fotoğraf yüklemek için galeri erişimi gerekir."
      }
    },
    "android": {
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/ATOLYEM_20260829_082715_0000.png",
        "backgroundColor": "#1a2a3e"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "package": "com.atolye.toolbox"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Kamera, barkod ve QR kod taramak için kullanılır."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Fotoğraf çekmek için kamera erişimi gerekir.",
          "photosPermission": "Fotoğraf yüklemek için galeri erişimi gerekir."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "63a8d19e-d9f8-4c66-9988-580dfa0c510e"
      },
      "router": {}
    }
  }
}
